{
  "version": "v1",
  "name": "phase-24-demo-3node",
  "description": "Phase 24 — Reproducible local 3-node cluster demo with static proxy routing. Three independent shardforge-node processes + one stateless routing proxy. No Raft, no consensus, no replication, no automatic failover, no shard migration. Static FNV-1a consistent-hash routing only.",
  "routing": {
    "algorithm": "fnv1a-consistent-hash",
    "virtual_nodes": 128
  },
  "proxy": {
    "enabled": true,
    "addr": "127.0.0.1:9200"
  },
  "nodes": [
    {
      "id": "node-1",
      "base_url": "http://127.0.0.1:9101",
      "addr": "127.0.0.1:9101",
      "data_dir": "/tmp/sfdb-demo-node-1",
      "weight": 1
    },
    {
      "id": "node-2",
      "base_url": "http://127.0.0.1:9102",
      "addr": "127.0.0.1:9102",
      "data_dir": "/tmp/sfdb-demo-node-2",
      "weight": 1
    },
    {
      "id": "node-3",
      "base_url": "http://127.0.0.1:9103",
      "addr": "127.0.0.1:9103",
      "data_dir": "/tmp/sfdb-demo-node-3",
      "weight": 1
    }
  ],
  "scope": {
    "static_config_only": true,
    "no_dynamic_membership": true,
    "no_discovery": true,
    "no_consensus": true,
    "no_raft": true,
    "no_replication": true,
    "no_failover": true,
    "no_shard_migration": true,
    "no_distributed_txns": true
  }
}
