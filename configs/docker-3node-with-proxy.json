{
  "version": "v1",
  "name": "docker-3node-with-proxy",
  "description": "3 independent nodes + 1 stateless routing proxy in Docker Compose. Node BaseURLs use Docker service DNS names. No Raft, no replication, no distributed cluster.",
  "routing": {
    "algorithm": "fnv1a-consistent-hash",
    "virtual_nodes": 128
  },
  "proxy": {
    "enabled": true,
    "addr": "0.0.0.0:9200"
  },
  "nodes": [
    {
      "id": "node-1",
      "base_url": "http://shardforge-node-1:9101",
      "addr": "0.0.0.0:9101",
      "data_dir": "/data/node-1",
      "weight": 1
    },
    {
      "id": "node-2",
      "base_url": "http://shardforge-node-2:9102",
      "addr": "0.0.0.0:9102",
      "data_dir": "/data/node-2",
      "weight": 1
    },
    {
      "id": "node-3",
      "base_url": "http://shardforge-node-3:9103",
      "addr": "0.0.0.0:9103",
      "data_dir": "/data/node-3",
      "weight": 1
    }
  ],
  "scope": {
    "static_config_only": true,
    "no_dynamic_membership": true,
    "no_discovery": true,
    "no_consensus": true,
    "no_raft": true,
    "no_replication": true,
    "no_failover": true,
    "no_shard_migration": true,
    "no_distributed_txns": true
  }
}
